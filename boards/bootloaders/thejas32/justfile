TARGET  := "riscv32im-unknown-none-elf"
OUT     := "target/" + TARGET + "/release"
KEY     := "keys/rustboot-dev.der"
LMS_KEY := "keys/lms-dev.key"

default:
    @just --list --unsorted

# Build rustBoot and convert it to a raw binary
build:
    cargo build --release -p rustboot-thejas32
    riscv32-unknown-elf-objcopy -O binary {{OUT}}/rustboot-thejas32 {{OUT}}/rustboot.bin
    @ls -l {{OUT}}/rustboot.bin

# Create a new signing key (refuses to overwrite one)
keygen:
    python3 tools/keygen.py

# Sign a raw application binary (ECDSA P-256 + LMS hybrid): just sign path/to/app.bin 1
sign app version:
    cd ../../../rbsigner && cargo run --release -q -- mcu-image {{absolute_path(app)}} nistp256 {{absolute_path(KEY)}} {{version}}
    cd ../../../rbsigner && cargo run --release -q -- lms-sign ../boards/sign_images/signed_images/{{file_stem(app)}}_v{{version}}_signed.bin {{absolute_path(LMS_KEY)}}

# How many LMS signatures the key has left (1024 in total)
lms-info:
    cd ../../../rbsigner && cargo run --release -q -- lms-info {{absolute_path(LMS_KEY)}}

# Create a new LMS key pair (stateful: 1024 signatures; refuses to overwrite)
lms-keygen:
    cd ../../../rbsigner && cargo run --release -q -- lms-keygen {{absolute_path("keys")}}/lms-dev.key {{absolute_path("keys")}}/lms_pubkey.bin

# Build rustBoot into flash.img for the CDAC flasher (`just flash`). Apps go in with `just update`.
provision: build
    python3 tools/pack.py {{OUT}}/rustboot.bin -o {{OUT}}/flash.img

# Build and sign the demo app as version N; confirm="0" builds one that never confirms
demo version confirm="1":
    DEMO_VERSION={{version}} DEMO_CONFIRM={{confirm}} cargo build --release -p demo-app
    riscv32-unknown-elf-objcopy -O binary {{OUT}}/demo-app {{OUT}}/demo-v{{version}}{{ if confirm == "0" { "-noconfirm" } else { "" } }}.bin
    just sign {{OUT}}/demo-v{{version}}{{ if confirm == "0" { "-noconfirm" } else { "" } }}.bin {{version}}

# Build and sign the crypto benchmark as version N; install it with `just app-update`
bench version:
    BENCH_VERSION={{version}} cargo build --release -p crypto-bench
    riscv32-unknown-elf-objcopy -O binary {{OUT}}/crypto-bench {{OUT}}/crypto-bench-v{{version}}.bin
    just sign {{OUT}}/crypto-bench-v{{version}}.bin {{version}}

# Write flash.img with the CDAC flasher (J12 open, then fitted). Free the serial port first.
flash img=(OUT + "/flash.img"):
    uv run tools/flash_persist.py {{img}}

# Install a signed image through rustBoot's recovery mode (J12 fitted), then boot it
update image:
    uv run tools/update.py {{image}}

# Update through the running app (its `u` command): no reset, no jumper
app-update image:
    uv run tools/app_update.py {{image}}

# Send keys to the running app: just console R   (demo-app: u = update, R = reboot)
console +keys:
    uv run tools/console.py {{keys}}

# Send recovery commands: just recovery i   (i = info, c = confirm, b = boot)
recovery cmds="i":
    uv run tools/update.py --cmds {{cmds}}

# Copy a signed image with its last byte flipped; `just update` must refuse it
tamper image:
    python3 -c "import sys; d=bytearray(open(sys.argv[1],'rb').read()); d[-1]^=1; open(sys.argv[2],'wb').write(d)" {{image}} {{OUT}}/tampered.bin
    @echo "{{OUT}}/tampered.bin -- expect: refused: HashMismatch"

# Host tests: signer vs verifier, and the state log / boot decision / XMODEM
test:
    cd ../../.. && cargo test -p rbsigner thejas32
    cargo test -p rb-state --target x86_64-unknown-linux-gnu --release
